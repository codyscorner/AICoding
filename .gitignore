# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Build artifacts
build/
dist/
*.spec
*.egg-info/

# C# build artifacts
bin/
obj/
*.pdb
*.cache
*.AssemblyInfo.cs
*.AssemblyAttributes.cs
*.csproj.user

# Virtual environments
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude
.claude/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
run_log.txt
batch_run_log.txt

# Local user configs (runtime state)
**/main_config.json
**/*_config.json

# API keys — never commit
api_keys.json
**/api_keys.json

# RunPod pod-control runtime state (which pod this app started)
**/runpod_session.json
**/*credentials*.txt
**/*credentials*.json

# Temp folders
**/temp/
**/upload_temp/
**/dropped_images/archive/

# Auto-generated app state
**/error_log.txt
**/settings.json
**/generation_history.json

# Sample / test media files
*.mp4
*.avi
*.mov
*.mkv

# Compiled executables and archives (too large for git)
*.exe
*.zip
*.msi
*.dmg
*.pkg
*.tar.gz
*.7z
*.rar

# NOTE: *.dll and *.pyd are NOT ignored — some apps bundle required
# binary dependencies. Include them if under GitHub's 50 MB file limit.

# Node.js
node_modules/
package-lock.json

# ML model weights
*.pt
*.pth
*.onnx
*.safetensors

# SQLite databases (embedding caches, runtime state)
*.sqlite
*.sqlite3
*.db
S3_Broswer/config.json

# Local-only test fixtures
Cumfy_Workflow_Editor/Test files/

# RunPod pod-control chain log
**/runpod_pod.log

ComfyUI_Style_Randomizer/logs/
